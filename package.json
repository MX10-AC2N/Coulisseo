{
  "name": "coulisseo",
  "version": "2.0.0",
  "type": "module",
  "homepage": "https://mx10-ac2n.github.io/Coulisseo/",
  "description": "Coulisseo : tableau de bord premium pour le suivi de statut d'intermittent du spectacle — anticipation du réexamen, module fiscal, dossier imprimable.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "test": "vitest run",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist --repo https://github.com/MX10-AC2N/Coulisseo.git",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
